# =================================================================
# DUKE1305 PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# Cổng truy cập ngoài (Mặc định 80 cho HTTP)
PORT=80

# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_USER=duke1305_user
POSTGRES_PASSWORD=duke_strong_db_password_2026
POSTGRES_DB=duke1305_db

# Bảo mật JWT & Cookie (Production yêu cầu JWT_SECRET >= 64 ký tự, COOKIE_SECRET >= 32 ký tự)
JWT_SECRET=super_secret_jwt_key_at_least_64_characters_long_for_production_use_random_entropy_here_2026
COOKIE_SECRET=super_secret_cookie_key_at_least_32_chars_2026

# Khóa mã hóa thông tin nhạy cảm ở cấp CSDL (Mã hóa AES-256-GCM, bắt buộc >= 32 ký tự)
DATA_ENCRYPTION_KEY=super_secret_aes_encryption_key_at_least_32_chars_2026
PREVIOUS_ENCRYPTION_KEYS=

# CORS & Domain Origin (Tuyệt đối không dùng localhost trên Production)
CORS_ORIGIN=https://duke1305.vn
VITE_SITE_URL=https://duke1305.vn

# Số proxy đáng tin cậy (Nginx reverse proxy đặt 1, truy cập trực tiếp đặt 0)
TRUST_PROXY_HOPS=1

# Tài khoản Quản trị viên khởi tạo khi seed
ADMIN_EMAIL=admin@duke1305.vn
ADMIN_PASSWORD=Admin@2026!Secure

# Cấu hình Cổng thanh toán SePay & VietQR
SEPAY_API_KEY=
SEPAY_BANK_CODE=MBBANK
SEPAY_ACCOUNT_NUMBER=0987654321
SEPAY_ACCOUNT_NAME=DUKE1305

# Cấu hình Gửi Email OTP (Resend, Brevo hoặc Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="no-reply@duke1305.vn"

# Cấu hình Bắn Thông Báo Telegram khi có đơn hàng mới (Tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
