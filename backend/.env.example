# Database
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/nexatopup?schema=public"

# JWT
JWT_SECRET="replace-with-at-least-64-random-characters"
JWT_EXPIRY="7d"

# Server
PORT=3000
NODE_ENV="development"

# Comma-separated browser origins
CORS_ORIGIN="http://localhost:5173"

# Cookie signing secret
COOKIE_SECRET="replace-with-at-least-32-random-characters"
AUTH_COOKIE_SAMESITE="strict"
AUTH_COOKIE_DOMAIN=""

# Required only when running the seed script
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"

# SePay webhook and VietQR
SEPAY_API_KEY=""
SEPAY_BANK_CODE="MBBANK"
SEPAY_ACCOUNT_NUMBER=""
SEPAY_ACCOUNT_NAME="DUKE1305"

# SMTP email OTP (Gmail app password, Resend SMTP, SendGrid SMTP, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@duke1305.vn"

# Telegram Notifications for new orders (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Dedicated encryption key, mandatory in production (at least 32 random characters).
# Empty is allowed only in development/test; production refuses to start without this key.
DATA_ENCRYPTION_KEY=""
PREVIOUS_ENCRYPTION_KEYS=""
# Direct access: 0. Exactly one trusted nginx proxy: 1.
TRUST_PROXY_HOPS=0
