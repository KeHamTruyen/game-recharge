{
  "name": "duke1305-topup-backend",
  "version": "1.0.0",
  "description": "DUKE1305 - Game Recharge Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap": "node dist/scripts/bootstrap.js",
    "db:bootstrap:dev": "tsx src/scripts/bootstrap.ts",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "db:migrate-passwords": "node dist/scripts/migrate_passwords.js",
    "db:migrate-passwords:dev": "tsx src/scripts/migrate_passwords.ts",
    "test": "node scripts/test.mjs",
    "test:email": "tsx scripts/test-email.ts",
    "test:telegram": "tsx scripts/test-telegram.ts",
    "test:container": "docker build -t duke1305-backend:shutdown-test . && node scripts/test-container-shutdown.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.14",
    "prisma": "^5.22.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
